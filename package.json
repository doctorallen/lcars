{
  "name": "esper-lcars",
  "displayName": "LCARS",
  "publisher": "esperinnovations",
  "version": "0.1.0",
  "description": "LCARS-inspired high-contrast themes for Visual Studio Code, including a generated accessibility-aware Q theme.",
  "main": "./extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/doctorallen/lcars.git"
  },
  "scripts": {
    "package:vsix": "vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  },
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Themes"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:lcars.generateQTheme",
    "onCommand:lcars.saveQTheme",
    "onCommand:lcars.pickSavedQTheme"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lcars.generateQTheme",
        "title": "LCARS: Generate Q Theme",
        "category": "LCARS"
      },
      {
        "command": "lcars.saveQTheme",
        "title": "LCARS: Save Current Q Theme",
        "category": "LCARS"
      },
      {
        "command": "lcars.pickSavedQTheme",
        "title": "LCARS: Pick Saved Q Theme",
        "category": "LCARS"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "lcars.generateQTheme"
        },
        {
          "command": "lcars.saveQTheme"
        },
        {
          "command": "lcars.pickSavedQTheme"
        }
      ]
    },
    "themes": [
      {
        "label": "LCARS",
        "uiTheme": "vs-dark",
        "path": "./themes/LCARS-color-theme.json"
      },
      {
        "label": "Q",
        "uiTheme": "vs-dark",
        "path": "./themes/Q-color-theme.json"
      },
      {
        "label": "LCARS: Picard",
        "uiTheme": "vs-dark",
        "path": "./themes/LCARS-Picard-color-theme.json"
      },
      {
        "label": "LCARS: Troi",
        "uiTheme": "vs-dark",
        "path": "./themes/LCARS-Troi-color-theme.json"
      },
      {
        "label": "LCARS: Data",
        "uiTheme": "vs-dark",
        "path": "./themes/LCARS-Data-color-theme.json"
      },
      {
        "label": "LCARS: Crusher",
        "uiTheme": "vs-dark",
        "path": "./themes/LCARS-Crusher-color-theme.json"
      }
    ]
  }
}
