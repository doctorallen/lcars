  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#9EA5BA"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#41C4F7"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "constant.other.symbol", "markup.quoted"],
      "settings": {
        "foreground": "#FCC19F"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.escape"],
      "settings": {
        "foreground": "#41C4F7"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "variable.function"],
      "settings": {
        "foreground": "#BAA4E5"
      }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": {
        "foreground": "#EDB378"
      }
    },
    {
      "name": "Tag names",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "support.tag"
      ],
      "settings": {
        "foreground": "#41C4F7"
      }
    },
    {
      "name": "Attribute names",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml"
      ],
      "settings": {
        "foreground": "#BAA4E5"
      }
    },
    {
      "name": "HTML attribute values",
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html",
        "string.unquoted.html"
      ],
      "settings": {
        "foreground": "#FCC19F"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.xml"
      ],
      "settings": {
        "foreground": "#D2D5DF"
      }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#FF977B"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#FF977B"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#BAA4E5",
    "method": "#BAA4E5",
    "type": "#EDB378",
    "class": "#EDB378",
    "interface": "#EDB378",
    "enum": "#EDB378",
    "typeParameter": "#EDB378",
    "variable": "#F3F4F7",
    "property": "#D2D5DF",
    "parameter": "#D2D5DF"
  }
}
